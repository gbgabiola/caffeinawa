# Required: use your own local database and private JWT secret.
DATABASE_URL=""
JWT_SECRET=""
WEB_URL=http://localhost:3000

# Optional API settings.
PORT=3001
AUTH_CLIENT_IP_SOURCE=socket

# Required only for database-backed tests; use a separate database containing test.
TEST_DATABASE_URL=""

# Optional PayMongo integration; disabled means cash-only checkout.
PAYMONGO_ENABLED=false
PAYMONGO_MODE=test
PAYMONGO_SECRET_KEY=""
PAYMONGO_WEBHOOK_SECRET=""
# Optional provider origin override; normally leave at the official endpoint.
PAYMONGO_API_URL=https://api.paymongo.com

# Optional admin photo uploads; credentials are required when enabled.
COFFEE_IMAGE_UPLOAD_ENABLED=false
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
