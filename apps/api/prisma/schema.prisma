datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Coffee {
  id          String         @id @default(uuid())
  name        String
  description String
  category    CoffeeCategory
  price       Decimal
  available   Boolean        @default(true)
  imageUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  orderItems  OrderItem[]
  cartItems   CartItem[]

  @@index([category, available])
  @@index([createdAt])
}

model Customer {
  id      String        @id @default(uuid())
  name    String
  email   String        @unique
  passwordHash String?
  role    CustomerRole  @default(CUSTOMER)

  cart    Cart?
  orders  Order[]

  @@index([name])
}

model Order {
  id         String      @id @default(uuid())
  customerId String
  status     OrderStatus @default(PENDING)
  total      Decimal
  createdAt  DateTime    @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  payments   Payment[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  unitPrice Decimal
  orderId   String
  coffeeId  String

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coffee    Coffee   @relation(fields: [coffeeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([coffeeId])
}

model Cart {
  id         String     @id @default(uuid())
  customerId String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String
  coffeeId String
  quantity Int

  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  coffee   Coffee @relation(fields: [coffeeId], references: [id], onDelete: Restrict)

  @@unique([cartId, coffeeId])
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  provider          PaymentProvider @default(CASH)
  checkoutSessionId String?         @unique
  paymentIntentId   String?
  providerEventId   String?         @unique
  amount            Decimal
  currency          String          @default("PHP")
  status            PaymentStatus   @default(PENDING)
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
  @@index([createdAt])
}

enum CoffeeCategory {
  espresso
  latte
  cappuccino
  americano
  cold_brew
  non_coffee
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CustomerRole {
  CUSTOMER
  ADMIN
}

enum PaymentProvider {
  CASH
  PAYMONGO
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentIssueReason {
  PAYMENT_NOT_FOUND
  INVALID_PROVIDER
  ORDER_REFERENCE_MISMATCH
  INVALID_PAYMENT_STATUS
  INVALID_ORDER_STATUS
  ORDER_NOT_FOUND
}

enum PaymentIssueStatus {
  OPEN
  REVIEWED
}

model PaymentReconciliationIssue {
  id                String             @id @default(uuid())
  providerEventId   String             @unique
  checkoutSessionId String
  paymentId         String?
  orderId           String?
  reason            PaymentIssueReason
  status            PaymentIssueStatus @default(OPEN)
  recordedAt        DateTime           @default(now())
  reviewedAt        DateTime?

  @@index([status, recordedAt])
  @@index([checkoutSessionId])
  @@index([orderId])
}

model StoreSettings {
  id              String   @id @default("main")
  acceptingOrders Boolean  @default(false)
  updatedAt       DateTime @default(now()) @updatedAt
}
