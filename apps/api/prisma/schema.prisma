datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Coffee {
  id          String         @id @default(uuid())
  name        String
  description String
  category    CoffeeCategory
  price       Decimal
  available   Boolean        @default(true)
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CoffeeCategory {
  espresso
  latte
  cappuccino
  americano
  cold_brew
  non_coffee
}
