datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Coffee {
  id          String         @id @default(uuid())
  name        String
  description String
  category    CoffeeCategory
  price       Decimal
  available   Boolean        @default(true)
  imageUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  orderItems  OrderItem[]
}

model Customer {
  id      String  @id @default(uuid())
  name    String
  email   String  @unique

  orders  Order[]
}

model Order {
  id         String      @id @default(uuid())
  customerId String
  status     OrderStatus @default(PENDING)
  total      Decimal
  createdAt  DateTime    @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  unitPrice Decimal
  orderId   String
  coffeeId  String

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coffee    Coffee   @relation(fields: [coffeeId], references: [id], onDelete: Restrict)
}

enum CoffeeCategory {
  espresso
  latte
  cappuccino
  americano
  cold_brew
  non_coffee
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
